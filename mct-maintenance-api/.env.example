# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# Email Configuration
EMAIL_ENABLED=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=SMART MAINTENANCE <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=SMART MAINTENANCE

# SMS - HSMS
USE_SMS_VERIFICATION=false
HSMS_API_URL=https://hsms.example.com/api
HSMS_TOKEN=your_hsms_token_here
HSMS_CLIENT_ID=your_hsms_client_id
HSMS_CLIENT_SECRET=your_hsms_client_secret
HSMS_SENDER_NAME=SMART-MAINTENANCE

# Paiement - CinetPay
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_SECRET_KEY=your_cinetpay_secret_key

# Paiement - FinéoPay
FINEOPAY_ENV=sandbox
FINEOPAY_BUSINESS_CODE=your_fineopay_business_code
FINEOPAY_API_KEY=your_fineopay_api_key

# Redis
REDIS_URL=redis://localhost:6379

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
